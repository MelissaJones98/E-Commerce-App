# Settings Create React App loads when running "npm start" (development only).
# Lines starting with # are comments. This file holds nothing secret, so it is committed.
#
# Run the React dev server on port 3001, because the API uses port 3000.
# Requests the dev server does not recognise (e.g. POST /auth/register) are passed on
# to the API by the "proxy" setting in package.json.
PORT=3001

# Work around a Create React App bug: when "proxy" is set, the dev server builds its list
# of allowed host names from this computer's private network address. If that address is
# not a 10.x, 172.16-31.x or 192.168.x one (e.g. on a VPN such as Tailscale), the list
# gets an empty entry and "npm start" crashes with
# "options.allowedHosts[0] should be a non-empty string".
# This turns the dev server's host check off, which is how it was before "proxy" was added
# (CRA only switches it on when a proxy is set). It only affects "npm start", never the
# production build.
DANGEROUSLY_DISABLE_HOST_CHECK=true
