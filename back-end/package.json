    "test": "node --env-file-if-exists=.env --env-file=.env.test --test --test-concurrency=1",
    "test:e2e": "newman run tests/e2e/ecommerce-api.e2e.postman_collection.json",
    "db:test:reset": "node --env-file-if-exists=.env --env-file=.env.test db/reset-test-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
