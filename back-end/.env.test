# Loaded after .env when running tests (npm test), overriding values in it.
# Points tests at a separate database so they never touch real data.
# Contains no secrets, so it is committed to Git.
PGDATABASE=ecommerce_test

# Signs session cookies in tests only. Not a real secret, so safe to commit.
SESSION_SECRET=test-only-session-secret

# Google and Facebook sign-in are OFF in tests, even if back-end/.env has real keys
# (.env loads first; these empty values override it). Empty means "not set".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Don't run connect-pg-simple's timer that deletes expired sessions during tests: a timer
# would keep the test process running, or query after the tests close the database.
SESSION_PRUNE=off
